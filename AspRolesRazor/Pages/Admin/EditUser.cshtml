@page
@model EditUser
@{
    ViewData["Title"] = "Edit User";
}

<div class="container mt-5">
    <h2 class="mb-4">Edit User</h2>

    <form method="post" class="needs-validation" novalidate>
        <div class="form-group mb-3">
            <label asp-for="@Model.User.UserName" class="form-label">Name</label>
            <input asp-for="@Model.User.UserName" name="userName" class="form-control" required />
            <span asp-validation-for="@Model.User.UserName" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
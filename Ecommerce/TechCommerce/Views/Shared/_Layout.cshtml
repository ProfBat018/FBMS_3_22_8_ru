@using Microsoft.AspNetCore.Mvc.Localization

@inject IViewLocalizer Localizer;


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>TechCommerce</title>
    <link rel="stylesheet" href="~/css/bootswatch.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>

<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand text-white" data-bs-toggle="modal" data-bs-target="#signInModal">TechCommerce</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["home"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">@Localizer["privacy"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Product" asp-action="Index">@Localizer["products"]</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item me-0">
                        <a class="nav-link" data-bs-toggle="modal" data-bs-target="#signInModal">
                            <i class="fas fa-sign-in-alt"></i>
                        </a>

                        <div class="modal fade" id="signInModal" tabindex="-1" aria-labelledby="signInModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content bg-light text-white">
                                    <div class="modal-header bg-light d-flex align-items-center justify-content-center position-relative">
                                        <h4 class="modal-title w-100 text-center" id="signInModalLabel">Sign In</h4>
                                        <button type="button" class="btn-close btn-close-primary position-absolute end-0 me-2" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>

                                    <div class="modal-body">
                                        <form>
                                            <div class="mb-3">
                                                <label for="username" class="form-label text-primary">Username</label>
                                                <input type="text" class="form-control bg-light text-primary border-primary" id="username" placeholder="Enter your username" required>
                                            </div>
                                            <div class="mb-3">
                                                <label for="password" class="form-label text-primary">Password</label>
                                                <input type="password" class="form-control bg-light text-primary border-primary" id="password" placeholder="Enter your password" required>
                                            </div>
                                            <div class="mb-3 form-check">
                                                <input type="checkbox" class="form-check-input" id="rememberMe" checked>
                                                <label class="form-check-label text-primary" for="rememberMe">Remember Me</label>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <a href="#" class="text-decoration-underline text-muted">Forgot Password?</a>
                                            </div>
                                            <button type="submit" class="btn btn-primary w-100">Sign In</button>
                                        </form>
                                    </div>
                                    <div class="modal-footer bg-light d-flex flex-column align-items-center">
                                        <div class="w-100 text-center mt-2">
                                            <span class="text-primary">Not registered yet?</span>
                                        </div>
                                        <a href="#" class="btn btn-outline-primary mt-2 w-100">Create an Account</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </li>
                    <li class="nav-item dropdown me-0">
                        <form asp-controller="Language" asp-action="SetLanguage" method="post">
                            <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-globe"></i>
                            </a>
                            <input style="visibility: hidden" name="path" value="@Context.Request.Path"/>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                            <li><button class="dropdown-item" type="submit" name="culture" value="ru-RU" >RU</button></li>
                            <li><button class="dropdown-item" type="submit" name="culture" value="en-US" >EN</button></li>
                            <li><button class="dropdown-item" type="submit" name="culture" value="az-AZ" >AZ</button></li>
                        </ul>
                        </form>
                    </li>
                </ul>

            </div>
        </div>
    </nav>
</header>


<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2024 - TechCommerce - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>


<script src="https://kit.fontawesome.com/a3d2e49c70.js" crossorigin="anonymous"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@model IEnumerable<TechCommerce.ViewModels.ProductViewModel>;

@{
    Layout = null;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-9">
            <div class="row">
                @foreach (var product in @Model)
                {
                  <partial name="_ProductPartial" model="product"/>
                }
            </div>
        </div>
    </div>
</div>
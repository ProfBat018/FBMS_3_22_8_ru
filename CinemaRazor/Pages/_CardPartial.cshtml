@model CinemaRazor.Data.Models.MovieInfo

<div class="col-md-4 mb-4">
    <div class="card">
        <img src="@Model.PosterPath" class="card-img-top" alt="Movie Poster">
        <div class="card-body">
            <h5 class="card-title">@Model.Title</h5>
            <p class="card-text">@Model.Overview</p>
            <p class="card-text"><small class="text-muted">Release Date: @Model.ReleaseDate</small></p>
        </div>
    </div>
</div>

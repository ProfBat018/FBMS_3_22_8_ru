@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="mt-5">
    <div class="row justify-content-center">
        <form method="post" asp-page-handler="title" class="d-flex justify-content-center w-100">
            <div class="form-row d-flex justify-content-center col-8">
                <div class="d-flex col-6">
                    <input type="text"  class="form-control m-1" id="movieTitle" name="title"
                           placeholder="Введите название фильма" required>
                </div>
                <div class="d-flex col-2">
                    <button type="submit" class="btn btn-primary btn-block m-1">Искать</button>
                </div>
            </div> 
        </form>
    </div>
</div>


<div class="row">
    
    @if (Model.SearchResult.Movies != null)
    {
        foreach (var Movie in Model.SearchResult.Movies)
        {
            <partial model="@Movie" name="_CardPartial"/>
        }
    }
</div>

@if (@Model.SearchResult.Movies != null)
{
<nav aria-label="Page navigation example">
    <ul class="pagination">
        <li class="page-item">
            <a class="page-link">Previous</a>
        </li>

        <li class="page-item">
            <a style="color: darkgreen" class="page-link disabled">@Model.SearchResult.Page</a>
        </li>
        @for (int i = 1; i < @Model.SearchResult.TotalPages; i++)
        {
        <form method="post" asp-page-handler="page" asp-route-currentPage="@i">
            <li class="page-item">
                <button type="submit" class="page-link">@i</button>
            </li>
        </form>

        }
        <li class="page-item">
            <a class="page-link">Next</a>
        </li>
    </ul>
</nav>
}
